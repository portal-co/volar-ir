pragma solidity ^0.8.20;

/// 256-lane packed Boolean circuit evaluation.
/// Lane zero is the least-significant bit of each packed word.
/// Generated by volar-evm-backend; compile with `--via-ir --optimize` so the
/// Yul optimizer can see this body (the legacy pipeline will not).
library VolarEvmSimd {
    function eval(uint256[] memory inputs) internal pure returns (uint256[] memory outputs) {
        assembly {
            let v0 := mload(add(inputs, 0x20))
            let v1 := mload(add(inputs, 0x40))
            let v2 := mload(add(inputs, 0x60))
            let v3 := xor(v0, v1)
            let v4 := xor(v3, v2)
            let v5 := and(v0, v1)
            let v6 := and(v2, v3)
            let v7 := or(v5, v6)
            outputs := mload(0x40)
            mstore(outputs, 2)
            mstore(add(outputs, 0x20), v4)
            mstore(add(outputs, 0x40), v7)
            mstore(0x40, add(outputs, 0x60))
        }
    }
}
